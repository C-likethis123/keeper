{
  "name": "keeper-pwa",
	"version": "1.0.0",
	"scripts": {
		"start": "vite --config vite.config.ts",
		"web:desktop": "vite --config vite.config.ts --host 127.0.0.1 --port 8082",
		"desktop": "tauri dev",
		"desktop:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
		"build:web": "npm run build:vite",
		"build:vite": "vite build --config vite.config.ts",
		"build:web:cloudflare": "VITE_SYNC_SERVER_URL=/api npm run build:vite",
		"deploy:web:cloudflare": "npm run build:web:cloudflare && npx wrangler deploy",
    "desktop:devtools": "sh -c 'trap \"kill 0\" INT TERM EXIT; react-devtools & npm run desktop & wait'",
    "build:desktop": "tauri build",
    "build:desktop:dev": "tauri build --config src-tauri/tauri.dev.conf.json --bundles app",
    "migrate:note-metadata": "node ./scripts/update-note-metadata.mjs",
		"test": "npm run test:vite",
		"test:watch": "npm run test:vite:watch",
    "test:vite": "vitest run --config vite.config.ts",
    "test:vite:watch": "vitest --config vite.config.ts",
	"test:browser": "playwright test --config playwright.config.ts",
    "typecheck:vite": "tsc --project web/tsconfig.json",
    "vite": "vite --config vite.config.ts",
    "lint": "biome lint .",
    "lint:fix": "biome check . --write",
    "knip": "knip",
    "build:viewers": "node scripts/build-viewers.js",
    "postinstall": "node scripts/build-viewers.js"
  },
	"dependencies": {
    "@lexical/code": "^0.45.0",
    "@lexical/code-prism": "^0.45.0",
    "@lexical/extension": "^0.45.0",
    "@lexical/history": "^0.45.0",
    "@lexical/link": "^0.45.0",
    "@lexical/list": "^0.45.0",
    "@lexical/markdown": "^0.45.0",
    "@lexical/react": "^0.45.0",
    "@lexical/rich-text": "^0.45.0",
    "@lexical/selection": "^0.45.0",
    "@lexical/table": "^0.45.0",
    "@lexical/yjs": "^0.45.0",
		"@tauri-apps/api": "~2.10.1",
		"@tauri-apps/plugin-dialog": "^2.7.0",
		"epubjs": "^0.3.93",
		"isomorphic-webcrypto": "^2.3.8",
    "katex": "^0.16.11",
    "lexical": "^0.45.0",
    "nanoid": "^5.1.6",
    "pdfjs-dist": "^4.10.38",
    "react": "19.1.0",
    "react-dom": "19.1.0",
		"react-router-dom": "^7.18.4",
    "yjs": "^13.6.31",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
		"@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^25.4.0",
    "@types/react": "~19.1.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@welldone-software/why-did-you-render": "^10.0.1",
		"fake-indexeddb": "^6.2.5",
		"jsdom": "^27.4.0",
		"jszip": "^3.10.1",
		"knip": "^5.86.0",
    "typescript": "~5.9.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  },
  "private": true
}
