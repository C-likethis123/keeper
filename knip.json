{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/**/*.test.{ts,tsx}",
        "web/src/**/*.test.{ts,tsx}",
        "web/e2e/**/*.spec.ts",
        "cloudflare/private-api-proxy/src/index.js"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "web/**/*.{ts,tsx}",
        "scripts/**/*.js",
        "cloudflare/**/*.js",
        "*.{ts,js}"
      ],
      "ignoreDependencies": [
        "epubjs",
        "pdfjs-dist",
        "jszip"
      ]
    },
    "server/api": {
      "project": [
        "src/**/*.ts"
      ]
    }
  },
  "tags": [
    "-lintignore"
  ]
}
